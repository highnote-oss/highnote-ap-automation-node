# Required
HIGHNOTE_API_KEY=sk_test_xxx
HIGHNOTE_CARD_PRODUCT_ID=pd_xxx
HIGHNOTE_APPLICATION_ID=app_xxx

# Auth
JWT_SECRET=change-me-in-prod

# Optional
HIGHNOTE_ENVIRONMENT=test
LOG_LEVEL=info
PORT=3000

# Public URL where this server is reachable. Required for auto-registering
# the webhook notification target and the /collaborative-auth endpoint in
# deployed environments. On Render, RENDER_EXTERNAL_URL is auto-injected and
# takes precedence — leave this unset there. Set it locally to an ngrok-style
# tunnel URL (e.g. https://abc123.ngrok.io) to exercise auto-registration in
# dev.
WEBHOOK_PUBLIC_URL=

# NODE_ENV switches deployed-demo behavior on (trustProxy for X-Forwarded-For,
# CORS strict-mode, serve prebuilt SPA from disk, require JWT_SECRET). Render
# sets this to "production" via render.yaml. Leave unset locally.
# NODE_ENV=production

# CORS origin override. In dev, defaults to http://localhost:5173 (Vite). In
# production (NODE_ENV=production) defaults to "same-origin only" — set this
# only if you serve the SPA from a different host than the API.
# CORS_ORIGIN=

# Content-Security-Policy soak-test toggle. When true, the browser logs CSP
# violations to the console instead of blocking them. Use to validate policy
# changes before enforcing.
# CSP_REPORT_ONLY=false

# SQLite database file path. Defaults to ./data/app.db relative to the API
# package. The directory is created on boot if missing.
# SQLITE_PATH=./data/app.db
